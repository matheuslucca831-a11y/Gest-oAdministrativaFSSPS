{
  "name": "gestao-clinica-fspss",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:electron": "cross-env BUILD_TARGET=electron next build",
    "start": "next start",
    "lint": "next lint",
    "electron": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.fspss.gestao-clinica",
    "productName": "Gestão Clínica FSPSS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "@types/node": "20.6.2",
    "@types/react": "18.2.22",
    "@types/react-dom": "18.2.7",
    "autoprefixer": "10.4.15",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "docx": "^9.6.1",
    "electron-updater": "^6.8.9",
    "eslint": "8.49.0",
    "eslint-config-next": "13.5.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "fs-extra": "^11.3.5",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.16.0",
    "next": "^13.5.1",
    "pizzip": "^3.2.0",
    "postcss": "8.4.30",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sweetalert2": "^11.26.25",
    "tailwindcss": "3.3.3",
    "typescript": "5.2.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^24.13.3"
  }
}